{
  "$schema": "https://raw.githubusercontent.com/niravraychura/terradrift/main/docs/terradrift.schema.json",
  "directory": "./terraform/dev",
  "output": "table",
  "timeout": "5m",
  "terraform_exec": true,
  "plan_mode": "refresh-only",
  "history_dir": ".terradrift-history",
  "dashboard_html": "terradrift-dashboard.html",
  "baseline_rules": [
    {
      "address": "aws_iam_role.example",
      "owner": "platform",
      "reason": "known long-lived identity drift",
      "expires_at": "2099-01-01T00:00:00Z"
    }
  ],
  "ignore_rules": [
    {
      "address": "aws_instance.example",
      "owner": "platform",
      "reason": "temporary exception while resizing",
      "expires_at": "2099-01-01T00:00:00Z"
    }
  ]
}
