{
  "directory": "./terraform/prod",
  "output": "json",
  "timeout": "10m",
  "terraform_exec": true,
  "plan_mode": "refresh-only",
  "redact_paths": true,
  "workspace_root": ".",
  "notification_throttle": true,
  "history_dir": ".terradrift-history",
  "allowed_commands": ["/usr/local/bin/conftest", "/usr/local/bin/infracost-adapter", "/usr/local/bin/audit-adapter"],
  "trusted_command_dirs": ["/usr/local/bin"],
  "policy_command": "/usr/local/bin/conftest",
  "policy_args": ["test", "-"],
  "cost_command": "/usr/local/bin/infracost-adapter",
  "audit_command": "/usr/local/bin/audit-adapter"
}
